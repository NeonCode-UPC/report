@startuml
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Paramédico / Conductor\n(Segmento 1)" as Driver
participant "Medical SMARTBOX\n(ESP32 + Peltier + HX711)" as Box
participant "Backend RESTful API\n(ASP.NET Core 10.0)" as API
database "MySQL 8.0\n(InnoDB)" as DB
actor "Farmacéutico / Cirujano\n(Segmento 2)" as Receiver

Driver -> API : POST /api/v1/dispatch-trips (Inicia traslado)
API -> Box : Comando LockContainer (Solenoide cerrado)
Box --> API : Evento ContainerLocked (200 OK)

loop Cada 10 segundos en ruta
    Box -> API : POST /api/v1/telemetry (Temp: +4.2°C, Peso, GPS, Batería)
    API -> DB : INSERT telemetry_logs (UUIDv7)
    alt Excursión térmica (> +8.0°C)
        API -> Driver : Alerta Acústica y Push Crítica
        API -> Receiver : Notificación de Contingencia Clínica
    end
end

Driver -> Receiver : Arribo a Hospital de Destino
Receiver -> API : POST /api/v1/custody/verify-otp (Token OTP)
API -> Box : Comando UnlockContainer
Box --> Receiver : Apertura autorizada + Acta SHA-256
@enduml
